# Copia este fichero a deploy/.env y cambia las claves y el token.
# Las claves y el token de abajo son EJEMPLOS FALSOS: no los uses tal cual.

# Rol dueño de la base de datos: lo crea Postgres y ejecuta las migraciones.
ODIN_DB_OWNER_USER=odin_owner
ODIN_DB_OWNER_PASSWORD=EJEMPLO-FALSO-cambia-esta-clave-dueno

# Clave del rol de la aplicación, odin_app (su nombre es fijo). Las migraciones lo crean UNA sola
# vez con esta clave: después del primer arranque queda fija en la base y cambiarla aquí no la cambia.
# Solo letras, dígitos, guion (-) y guion bajo (_): se interpola en SQL (migración V4).
ODIN_DB_APP_PASSWORD=EJEMPLO-FALSO-cambia-esta-clave-app

# Nombre de la base de datos (la URL JDBC la monta Compose).
ODIN_DB_NAME=odin

# Token de la instalación inicial (primer administrador de grupo).
ODIN_SETUP_TOKEN=EJEMPLO-FALSO-token-de-instalacion

# Origen del panel en el navegador; debe coincidir con ODIN_PANEL_PORT.
ODIN_PANEL_ORIGIN=http://127.0.0.1:8088

# Tamaño máximo de subida en bytes: lo usan la API y el nginx del panel.
ODIN_UPLOAD_MAX_BYTES=52428800

# Puertos publicados, siempre en 127.0.0.1.
ODIN_PANEL_PORT=8088
ODIN_API_PORT=8080
ODIN_MCP_PORT=8090

# Marca de la instalación (opcional): carpeta con brand.json y el logo. Sin esta variable se usa la de E2D.
# ODIN_BRAND_DIR=/ruta/a/la/marca/del/cliente
