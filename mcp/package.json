{
  "name": "odin-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate:types": "openapi-typescript ../api/openapi.json -o src/api/types.ts",
    "check:types": "openapi-typescript ../api/openapi.json -o node_modules/.cache-types.ts && diff -q node_modules/.cache-types.ts src/api/types.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:stdio": "tsx src/stdio.ts",
    "start:http": "tsx src/http.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
