# Copia este fichero a deploy/.env y cambia TODOS los valores.
# Los valores de abajo son EJEMPLOS FALSOS: no los uses tal cual.

# Rol dueño de la base de datos: lo crea Postgres y ejecuta las migraciones.
ODIN_DB_OWNER_USER=odin_owner
ODIN_DB_OWNER_PASSWORD=EJEMPLO-FALSO-cambia-esta-clave-dueno

# Rol de la aplicación (odin_app). Las migraciones lo crean UNA sola vez con esta
# clave: después del primer arranque queda fija en la base y cambiarla aquí no la cambia.
# Solo letras, dígitos, guion (-) y guion bajo (_): se interpola en SQL (migración V4).
ODIN_DB_APP_USER=odin_app
ODIN_DB_APP_PASSWORD=EJEMPLO-FALSO-cambia-esta-clave-app

# Nombre de la base de datos y URL JDBC (el host "postgres" es el servicio de Compose).
ODIN_DB_NAME=odin
ODIN_DB_URL=jdbc:postgresql://postgres:5432/odin

# Token de la instalación inicial (primer administrador de grupo).
ODIN_SETUP_TOKEN=EJEMPLO-FALSO-token-de-instalacion

# Origen del panel en el navegador; debe coincidir con ODIN_PANEL_PORT.
ODIN_PANEL_ORIGIN=http://127.0.0.1:8088

# Directorio de originales dentro del contenedor (volumen "originals") y tamaño máximo de subida (bytes).
ODIN_ORIGINALS_DIR=/var/lib/odin/originals
ODIN_UPLOAD_MAX_BYTES=52428800

# Puertos publicados, siempre en 127.0.0.1.
ODIN_PANEL_PORT=8088
ODIN_API_PORT=8080
ODIN_MCP_PORT=8090
